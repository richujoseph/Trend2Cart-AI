# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never put this in the web app.
SUPABASE_SERVICE_ROLE_KEY=
# Only if your project still uses the legacy HS256 JWT secret (Settings → JWT Keys). Leave empty otherwise.
SUPABASE_JWT_SECRET=
# Comma-separated list of web origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# serpapi.com → Dashboard. Only used by scripts/enrich.py (2 searches per product).
SERPAPI_API_KEY=

# LLM: any OpenAI-compatible API. Default: Gemini free tier (aistudio.google.com → Get API key).
LLM_API_KEY=
# Optional overrides (defaults shown). Groq: https://api.groq.com/openai/v1 + llama-3.3-70b-versatile
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash

# TTS: sarvam (free credits, no card) or google (free monthly quota, needs billing card)
TTS_PROVIDER=sarvam
SARVAM_API_KEY=
GOOGLE_TTS_API_KEY=

# Razorpay TEST MODE keys for the ₹99 pre-order (dashboard.razorpay.com → switch to Test Mode → API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
